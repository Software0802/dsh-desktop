{
  "name": "pi-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A Pi-powered desktop client that mirrors the DeepSeek Harness UI",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.10.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
